{
  "name": "computer-use-harness",
  "version": "0.1.0",
  "description": "CLI-first computer-use harness for local app automation.",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "bin": {
    "computer-use": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli/index.js",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli/index.js"
  },
  "dependencies": {
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
